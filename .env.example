# Copier ce fichier en ".env.local" puis renseigner les clés EmailJS
# (https://dashboard.emailjs.com) pour que le formulaire de contact envoie
# directement les messages. Sans ces clés, le formulaire ouvre la messagerie du visiteur.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Docker uniquement : port de la machine sur lequel le site est publié (8080 par défaut)
# SITE_PORT=8080
